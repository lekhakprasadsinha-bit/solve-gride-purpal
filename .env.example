# ============================================================
# SolveGrid Environment Configuration Template
# Duplicate this file as .env.local to configure real credentials
# ============================================================

# Official website domain URL
NEXT_PUBLIC_SITE_URL=https://www.solvegrid.in

# Primary technical contact email
NEXT_PUBLIC_CONTACT_EMAIL=hello@solvegrid.in

# Official WhatsApp Contact Number (digits only with country code, e.g., 919876543210)
# Leave blank to use documented default inquiry fallback
NEXT_PUBLIC_WHATSAPP_NUMBER=
